<!-- My Stuff -->
<script type="text/javascript" src="/js/constants.js?v={$app_version}"></script>
<script type="text/javascript" src="/js/functions.min.js?v={$app_version}"></script>
<script type="text/javascript" src="/js/config.min.js?v={$app_version}"></script>
<script type="module">
	import CompanyApp from "/js/company/company.app.min.js";
	
	const config = new Config({$site->getClientConfiguration()});
	const translations = {$site->getTranslationsJson()};

    let user = {json_encode($site->getUser()->marshall(), 160)};
	let app = null;

	window.addEventListener('load', function(){
		window.translations = translations;

		app = new CompanyApp(config,{
			user,
			translations
		});
		window.app = app;
		window.config = config;
		app.execute();
	});
</script>
<!-- Current Template Specific Script File -->
<script type="text/javascript" src="{$script_file}"></script>