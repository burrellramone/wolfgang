	/**
	 *
	 * @return IDsn
	 */
	public function getDsn ( ): IDsn;
	
	/**
	 *
	 * @return string
	 */
	public function getDatabase ( ): string;
	
	/**
	 *
	 * @return ISchema
	 */
	public function getInformationSchema ( ): ISchema;
}
