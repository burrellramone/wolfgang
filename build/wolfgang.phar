            } catch (Exception $e) {
                self::log($e);
            }
        }
        
        if ($mobileRegistrationTokens) {
            try {
                self::sendMobilePushNotifications($mobileRegistrationTokens, $mobilePayload);
            } catch (Exception $e) {
                if ($e instanceof Google_Service_Exception) {
                    self::log($e->getMessage());
                } else {
                    self::log($e);
                }
            }
        }*/
    }
    
