 */
final class Manager extends Component implements ISingleton {
	use TSingleton;
	
	/**
	 *
	 * @var Session
	 */
	protected $session;


	/**
	 * @param string $kind
	 * @param array $options
	 * @return ISession
	 */
	public function createSession(string $kind, array $options = array()){
		$options['kind'] = $kind;
		
		$this->session = Session::create($options);

		return $this->session;
	} 

	/**
	 * @return ISession
	 */
	public function getSession (  ): ?ISession {
		if( $this->session ) {
			return $this->session;
		}

		return null;
	}
